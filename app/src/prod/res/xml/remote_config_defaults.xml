<?xml version="1.0" encoding="utf-8"?>
<defaultsMap>
    <!-- Production Environment Settings -->
    <entry key="feature_new_ui" value="false" />
    <entry key="feature_advanced_search" value="false" />
    <entry key="feature_dark_mode" value="true" />
    <entry key="feature_offline_mode" value="false" />
    <entry key="feature_biometric_auth" value="true" />
    
    <!-- API Configuration -->
    <entry key="api_timeout_seconds" value="10" />
    <entry key="max_items_per_page" value="50" />
    <entry key="retry_attempts" value="3" />
    <entry key="cache_duration_hours" value="24" />
    
    <!-- App Configuration -->
    <entry key="app_version_required" value="1.0.0" />
    <entry key="force_update" value="false" />
    <entry key="maintenance_mode" value="false" />
    <entry key="maintenance_message" value="The app is currently under maintenance. Please try again later." />
    
    <!-- Debug Settings -->
    <entry key="enable_debug_logging" value="false" />
    <entry key="enable_analytics" value="true" />
    <entry key="enable_crashlytics" value="true" />
    <entry key="enable_performance_monitoring" value="true" />
    
    <!-- UI Configuration -->
    <entry key="default_theme" value="system" />
    <entry key="animation_duration_ms" value="300" />
    <entry key="pull_to_refresh_enabled" value="true" />
    <entry key="infinite_scroll_enabled" value="true" />
    
    <!-- Security Settings -->
    <entry key="session_timeout_minutes" value="30" />
    <entry key="max_login_attempts" value="3" />
    <entry key="password_min_length" value="8" />
    <entry key="require_strong_password" value="true" />

    <entry key="enable_ads" value="false" />
    <entry key="enable_banner_ads" value="false" />
    <entry key="enable_interstitial_ads" value="false" />
</defaultsMap>
